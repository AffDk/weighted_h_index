# Weighted H-Index — environment variables
# Copy this file to `.env` and fill in your keys.
# NEVER commit `.env` — it is gitignored.

# LLM provider to use: gemini
LLM_PROVIDER=gemini

# OpenAlex API key (free, required for data fetching)
# Get key at: https://openalex.org/settings/api  (or POST /api-keys with your email)
OPENALEX_API_KEY=...

# Google AI Studio (Gemini)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sk-...
# Optional: Gemini API base URL
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Optional: Gemini model override
# GEMINI_MODEL=gemini-2.5-flash
