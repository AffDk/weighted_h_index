# Weighted H-Index — environment variables
# Copy this file to `.env` and fill in your keys.
# NEVER commit `.env` — it is gitignored.

# LLM provider to use: qwen | deepseek | kimi | glm
LLM_PROVIDER=qwen

# OpenAlex API key (free, required for data fetching)
# Get key at: https://openalex.org/settings/api  (or POST /api-keys with your email)
OPENALEX_API_KEY=...

# Alibaba Cloud DashScope (Qwen) — primary, cheapest
# Get key at: https://help.aliyun.com/zh/dashscope/developer-reference/api-details
DASHSCOPE_API_KEY=sk-...

# DeepSeek — fallback
# Get key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Moonshot (Kimi)
MOONSHOT_API_KEY=sk-...

# Zhipu AI (GLM)
ZHIPU_API_KEY=...
